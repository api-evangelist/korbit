{
  "opencollection": "1.0.0",
  "info": {
    "name": "Korbit Open API v2 Asset API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Asset",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.korbit.co.kr/v2/balance",
            "params": [
              {
                "name": "accountSeq",
                "value": "",
                "type": "query",
                "description": "Account sequence number. Defaults to 1 (main account)."
              },
              {
                "name": "currencies",
                "value": "",
                "type": "query",
                "description": "List of assets to query. Enter them separated by commas (,). If this field is not provided, all currently held assets will be queried."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-KAPI-KEY",
              "value": "{{X-KAPI-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get balance."
        }
      ]
    }
  ],
  "bundled": true
}